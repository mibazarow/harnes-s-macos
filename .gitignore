# Build output
.build/
DerivedData/
build/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
xcuserdata/
*.xcuserstate
*.xcarchive

# Release artifacts: a 17 MB dmg has no business in git
dist/
*.dmg
*.zip


# Xcode project is generated by XcodeGen from project.yml
Harness.xcodeproj/

# macOS noise
.DS_Store
._*
*.log

# Editors
.vscode/
.idea/
*.swp
.claude/
.kilo*/
.kilocodeignore

# Local secrets and data — never commit
.env
.env.*
*.local.json
*.pem
*.p12
*.key
*.cer
*.csr
*.mobileprovision

# Privileged scripts generated by tools/sudo/run-sudo.sh
tools/sudo/pending/

# Local runtime data (lives outside the repo, but guard anyway)
HARNES_S_DATA/

# Local release token (never commit)
/DOCS/github-token.md
